# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
*.tsbuildinfo

# Local database (created at runtime)
database/*.duckdb
database/*.duckdb.wal
*.duckdb
*.duckdb.wal

# Secrets & local configuration - never commit
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets/
credentials*.json

# Optional white-label client logo (third-party trademarks stay local)
frontend/public/brand/*
!frontend/public/brand/README.md

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
