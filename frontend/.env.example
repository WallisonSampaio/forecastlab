# Copy to .env.local (git-ignored) to customise the frontend.

# Backend URL when not using the Vite proxy (default: same origin, /api)
# VITE_API_URL=http://localhost:8000

# Optional white-label logo for private demos - see public/brand/README.md
# VITE_CLIENT_LOGO_URL=/brand/client-logo.png
# VITE_CLIENT_NAME=Client name
